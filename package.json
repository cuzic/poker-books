{
  "name": "poker-books",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts --book all",
    "build:vol1": "bun run scripts/build.ts --book vol1-preflop",
    "build:vol2": "bun run scripts/build.ts --book vol2-postflop",
    "build:vol3": "bun run scripts/build.ts --book vol3-tell",
    "build:epub": "bun run scripts/build.ts --book all --format epub",
    "build:site": "bun run scripts/build.ts --book all --format all",
    "lint": "bun run lint:md && bun run lint:text",
    "lint:md": "markdownlint-cli2",
    "lint:text": "textlint \"{vol1-preflop,vol2-postflop,vol3-tell}/chapters/**/*.md\"",
    "lint:fix": "bun run lint:md:fix && bun run lint:text:fix",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:text:fix": "textlint --fix \"{vol1-preflop,vol2-postflop,vol3-tell}/chapters/**/*.md\"",
    "batch-improve": "./scripts/batch-improve.sh",
    "check:epub": "bun run scripts/check-epub.ts",
    "check:epub:vol1": "bun run scripts/check-epub.ts --book vol1-preflop",
    "check:epub:vol2": "bun run scripts/check-epub.ts --book vol2-postflop",
    "check:epub:vol3": "bun run scripts/check-epub.ts --book vol3-tell",
    "kdp:metadata": "bun run scripts/generate-kdp-metadata.ts",
    "images:prompts": "bun run scripts/generate-image-batch.ts",
    "images:submit": "bun run scripts/submit-image-batch.ts",
    "images:status": "python3 scripts/check-batch-status.py",
    "images:download": "python3 scripts/download-images.py"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21",
    "@resvg/resvg-js": "^2.6.2",
    "epub-gen-memory": "^1",
    "rehype-raw": "^7",
    "rehype-stringify": "^10",
    "remark-cjk-friendly": "^1",
    "remark-cjk-friendly-gfm-strikethrough": "^1",
    "remark-gfm": "^4",
    "remark-parse": "^11",
    "remark-rehype": "^11",
    "unified": "^11",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.14.0",
    "@types/bun": "latest",
    "markdown-it": "^14.1.1",
    "markdown-it-cjk-friendly": "^2.0.2",
    "markdownlint-cli2": "^0.20.0",
    "playwright": "^1.59.1",
    "textlint": "^15.5.1",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-jtf-style": "^3.0.3",
    "textlint-rule-prh": "^6.1.0",
    "typescript": "^5",
    "unist-util-visit-parents": "^6.0.2"
  }
}
